{
  "rules": [
    {
      "allowed": {
        "origins": ["https://drive.orole.be", "https://orole-drive.vercel.app", "http://localhost:3000"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "If-None-Match", "x-amz-meta-upload-id", "Range", "x-amz-checksum-crc32", "x-amz-sdk-checksum-algorithm"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range"],
      "maxAgeSeconds": 3600
    }
  ]
}

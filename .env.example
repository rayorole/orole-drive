# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Storage (Cloudflare R2)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: malware lookups
VIRUSTOTAL_API_KEY=

# Scheduled cleanup and search indexing (Vercel cron)
CRON_SECRET=

# Optional: AI search. Leave the Cloudflare values empty to keep search off.
# The API token needs "Workers AI: Read" and "Vectorize: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
VECTORIZE_INDEX=orole-drive-search
# Image captions and "Ask your drive" answers go through OpenRouter.
OPENROUTER_API_KEY=
SEARCH_CAPTION_MODEL=anthropic/claude-haiku-4.5
SEARCH_CHAT_MODEL=anthropic/claude-sonnet-5
